# Local RAG Environment Configuration
# Copy to .env and modify as needed

# Server
HOST=127.0.0.1
PORT=8000

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu  # cpu or cuda

# Generation (optional)
GENERATION_ENABLED=false
GENERATION_PROVIDER=ollama  # ollama or openai_compatible
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=not-needed
OPENAI_COMPATIBLE_MODEL=local-model

# Security
API_KEY_ENABLED=false
API_KEYS_FILE=/app/secrets/api_keys.json

# File Ingestion
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=txt,md,pdf,docx,html,json,jsonl,csv,yaml,py,js,ts,css,sql,sh

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# Performance
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=10
RRF_K=60